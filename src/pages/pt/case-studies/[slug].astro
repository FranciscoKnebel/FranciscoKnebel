---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import CaseStudyPage from '../../../components/CaseStudyPage.astro';

export async function getStaticPaths() {
  const entries = await getCollection('caseStudies', ({ data }) => data.lang === 'pt');
  return entries.map((entry) => ({
    params: { slug: entry.id.split('/')[1] },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<Layout
  lang="pt"
  title={`${entry.data.title} | Francisco Knebel`}
  description={entry.data.description}
  noindex={entry.data.status === 'planned'}
>
  <CaseStudyPage entry={entry} lang="pt" />
</Layout>
