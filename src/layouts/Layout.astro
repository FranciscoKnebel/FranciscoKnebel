---
import type { Lang } from '../types';
import ui from '../data/ui.json';
import socials from '../data/social.json';
import Consent from '../components/Consent.astro';
import LanguageNotice from '../components/LanguageNotice.astro';
import { localePaths } from '../lib/i18n';
import '../styles/global.css';

interface Props {
  lang: Lang;
  noindex?: boolean;
  title?: string;
  description?: string;
}

const {
  lang,
  noindex = false,
  title: titleOverride,
  description: descriptionOverride,
} = Astro.props;
const meta = ui[lang].meta;
const title = titleOverride ?? meta.title;
const description = descriptionOverride ?? meta.description;

const pathname = Astro.url.pathname;
const canonical = new URL(pathname, Astro.site).href;
const ogImage = new URL(lang === 'pt' ? '/og-image.pt.png' : '/og-image.png', Astro.site).href;

const { en: enPath, pt: ptPath } = localePaths(pathname, lang);
const alternates = [
  { hreflang: 'en', href: new URL(enPath, Astro.site).href },
  { hreflang: 'pt', href: new URL(ptPath, Astro.site).href },
  { hreflang: 'x-default', href: new URL(enPath, Astro.site).href },
];

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': 'https://franciscoknebel.com/#person',
  name: 'Francisco Knebel',
  url: new URL('/', Astro.site).href,
  image: ogImage,
  jobTitle: lang === 'pt' ? 'Engenheiro de Software Líder' : 'Lead Software Engineer',
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Universidade Federal do Rio Grande do Sul (UFRGS)',
    url: 'https://ufrgs.br',
  },
  sameAs: socials.map((s) => s.href),
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Francisco Knebel" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'pt' ? 'pt_BR' : 'en_US'} />
    <meta property="og:site_name" content="Francisco Knebel" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={description} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#020617" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {
      !noindex &&
        alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)
    }
    <title>{title}</title>

    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body class="bg-white font-sans text-slate-900 antialiased dark:bg-slate-950 dark:text-slate-100">
    <a
      href="#main"
      class="focus:bg-accent-600 sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[60] focus:rounded-lg focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-white focus:shadow-lg"
      >{ui[lang].a11y.skipToContent}</a
    >
    <slot />
    <Consent lang={lang} />
    <LanguageNotice lang={lang} />

    <script>
      // Animate only after intersection; never hide content while waiting for JavaScript.
      if (
        'IntersectionObserver' in window &&
        'animate' in Element.prototype &&
        !window.matchMedia('(prefers-reduced-motion: reduce)').matches
      ) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              observer.unobserve(entry.target);
              const targets = entry.target.classList.contains('reveal-stagger')
                ? Array.from(entry.target.children)
                : [entry.target];
              targets.forEach((target, index) => {
                target.animate(
                  [{ transform: 'translateY(12px)' }, { transform: 'translateY(0)' }],
                  { duration: 350, delay: Math.min(index, 5) * 40, easing: 'ease-out' },
                );
              });
            });
          },
          { threshold: 0.08 },
        );
        document.querySelectorAll('.reveal, .reveal-stagger').forEach((el) => {
          observer.observe(el);
        });
      }
    </script>
  </body>
</html>
