---
import type { Lang } from '../types';
import ui from '../data/ui.json';
import socials from '../data/social.json';
import Consent from '../components/Consent.astro';
import LanguageNotice from '../components/LanguageNotice.astro';
import '../styles/global.css';

interface Props {
  lang: Lang;
  noindex?: boolean;
  title?: string;
  description?: string;
}

const {
  lang,
  noindex = false,
  title: titleOverride,
  description: descriptionOverride,
} = Astro.props;
const meta = ui[lang].meta;
const title = titleOverride ?? meta.title;
const description = descriptionOverride ?? meta.description;

const pathname = Astro.url.pathname;
const canonical = new URL(pathname, Astro.site).href;
const ogImage = new URL(lang === 'pt' ? '/og-image.pt.png' : '/og-image.png', Astro.site).href;

const enPath = lang === 'pt' ? pathname.replace(/^\/pt(?=\/|$)/, '') || '/' : pathname;
const ptPath = enPath === '/' ? '/pt/' : `/pt${enPath}`;
const alternates = [
  { hreflang: 'en', href: new URL(enPath, Astro.site).href },
  { hreflang: 'pt', href: new URL(ptPath, Astro.site).href },
  { hreflang: 'x-default', href: new URL(enPath, Astro.site).href },
];

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Francisco Knebel',
  url: new URL('/', Astro.site).href,
  image: ogImage,
  jobTitle: lang === 'pt' ? 'Engenheiro de Software Líder' : 'Lead Software Engineer',
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Universidade Federal do Rio Grande do Sul (UFRGS)',
    url: 'https://ufrgs.br',
  },
  sameAs: socials.map((s) => s.href),
};
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Francisco Knebel" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'pt' ? 'pt_BR' : 'en_US'} />
    <meta property="og:site_name" content="Francisco Knebel" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={description} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#020617" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {
      !noindex &&
        alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)
    }
    <title>{title}</title>

    <script type="application/ld+json" set:html={JSON.stringify(person)} />

    <!-- Keep content visible when JavaScript is unavailable -->
    <noscript>
      <style>
        .reveal,
        .reveal-stagger > * {
          opacity: 1;
          transform: none;
        }
      </style>
    </noscript>
  </head>
  <body class="bg-white font-sans text-slate-900 antialiased dark:bg-slate-950 dark:text-slate-100">
    <a
      href="#about"
      class="focus:bg-accent-600 sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[60] focus:rounded-lg focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-white focus:shadow-lg"
      >{ui[lang].a11y.skipToContent}</a
    >
    <slot />
    <Consent lang={lang} />
    <LanguageNotice lang={lang} />

    <script>
      // Intersection Observer for scroll-triggered reveals
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.08, rootMargin: '-40px 0px' },
      );

      document.querySelectorAll('.reveal, .reveal-stagger').forEach((el) => {
        observer.observe(el);
      });
    </script>
  </body>
</html>
