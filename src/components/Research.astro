---
import type { Lang, Publication } from '../types';
import ui from '../data/ui.json';
import rawPublications from '../data/publications.json';
import publicationsMeta from '../data/publications-meta.json';
import interestsData from '../data/interests.json';
import { mergePublications, publicationTypeColors } from '../lib/publications';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

const meta: Record<string, Partial<Publication>> = publicationsMeta;
const publicationsData = mergePublications(rawPublications, meta);
const typeColors = publicationTypeColors;
const publicationsUrl = lang === 'pt' ? '/pt/publications/' : '/publications/';
---

<section
  id="research"
  class="border-t border-slate-100 py-24 dark:border-slate-800/60"
  aria-labelledby="research-heading"
>
  <div class="mx-auto max-w-6xl px-6">
    <h2 id="research-heading" class="section-heading reveal">{t.sections.research}</h2>

    <!-- Interests -->
    <div class="reveal mb-14">
      <h3 class="mb-4 text-sm font-medium text-slate-700 dark:text-slate-300">
        {t.sections.interests}
      </h3>
      <div class="flex flex-wrap gap-2">
        {
          interestsData.map((interest) => (
            <span class="rounded-full border border-slate-200 bg-slate-100 px-3 py-1.5 text-sm font-medium text-slate-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300">
              {interest[lang]}
            </span>
          ))
        }
      </div>
    </div>

    <!-- Publications -->
    <div>
      <h3 class="reveal mb-6 text-sm font-medium text-slate-700 dark:text-slate-300">
        {t.sections.publications}
      </h3>
      <div class="reveal-stagger space-y-4">
        {
          publicationsData.map((pub) => (
            <article class="card-hover group rounded-xl border border-slate-200 bg-slate-50 p-5 dark:border-slate-800 dark:bg-slate-900/50">
              <div class="flex items-start justify-between gap-4">
                <div class="min-w-0 flex-1">
                  <div class="mb-2 flex flex-wrap items-center gap-2">
                    <span
                      class={`inline-flex items-center rounded-md px-2 py-0.5 text-xs font-semibold ${typeColors[pub.type] ?? 'bg-slate-100 text-slate-600'}`}
                    >
                      {t.publications.types[pub.type as keyof typeof t.publications.types] ??
                        pub.type}
                    </span>
                    <span class="inline-flex items-center rounded-md bg-slate-300 px-2 py-0.5 text-xs text-slate-600 dark:bg-slate-800 dark:text-slate-400">
                      {pub.year}
                    </span>
                    {pub.citations ? (
                      <span class="inline-flex items-center rounded-md bg-slate-200 px-2 py-0.5 text-xs text-slate-600 dark:bg-slate-800 dark:text-slate-400">
                        {pub.citations} {t.publications.citations}
                      </span>
                    ) : null}
                  </div>

                  {pub.url ? (
                    <a
                      href={pub.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="group-hover:text-accent-600 dark:group-hover:text-accent-400 text-sm leading-snug font-medium text-slate-900 underline-offset-2 transition-colors duration-150 hover:underline dark:text-slate-100"
                    >
                      {pub.title}
                    </a>
                  ) : (
                    <p class="text-sm leading-snug font-medium text-slate-900 dark:text-slate-100">
                      {pub.title}
                    </p>
                  )}

                  <p class="mt-1.5 text-xs text-slate-500 dark:text-slate-400">
                    {pub.authors.join(', ')}
                  </p>

                  <p class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">
                    {pub.venueUrl ? (
                      <a
                        href={pub.venueUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="hover:text-accent-500 hover:decoration-accent-400 dark:hover:text-accent-400 underline decoration-slate-300 underline-offset-2 transition-colors duration-150 dark:decoration-slate-600"
                      >
                        {pub.venue}
                      </a>
                    ) : (
                      pub.venue
                    )}
                    {pub.advisor && (
                      <span class="text-slate-500 dark:text-slate-400">
                        {' '}
                        · {t.publications.advisor}:{' '}
                        {pub.advisorUrl ? (
                          <a
                            href={pub.advisorUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="hover:text-accent-400 hover:decoration-accent-400 dark:hover:text-accent-400 underline decoration-slate-300 underline-offset-2 transition-colors duration-150 dark:decoration-slate-600"
                          >
                            {pub.advisor}
                          </a>
                        ) : (
                          pub.advisor
                        )}
                      </span>
                    )}
                  </p>
                </div>

                {pub.url && (
                  <a
                    href={pub.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Open ${pub.title}`}
                    class="group-hover:text-accent-500 focus-visible:ring-accent-500 dark:group-hover:text-accent-400 mt-1 flex-shrink-0 rounded text-slate-300 transition-colors duration-150 focus-visible:ring-2 focus-visible:outline-none dark:text-slate-600"
                  >
                    <svg
                      class="h-4 w-4"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                      />
                    </svg>
                  </a>
                )}
              </div>
            </article>
          ))
        }
      </div>

      <p class="reveal mt-6 text-xs text-slate-500 dark:text-slate-400">
        {t.sections.fullPublicationsList}{' '}
        <a
          href="https://scholar.google.com/citations?user=_RHtqxIAAAAJ"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-accent-500 underline underline-offset-2 transition-colors duration-150"
          >Google Scholar</a
        >
        {lang === 'en' ? ' and ' : ' e '}
        <a
          href="https://www.researchgate.net/profile/Francisco-Knebel"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-accent-500 underline underline-offset-2 transition-colors duration-150"
          >ResearchGate</a
        >.
      </p>

      <a
        href={publicationsUrl}
        class="reveal text-accent-600 hover:text-accent-500 dark:text-accent-400 dark:hover:text-accent-300 mt-4 inline-flex items-center gap-1.5 text-sm font-medium transition-colors duration-150"
      >
        {t.sections.allPublications}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
