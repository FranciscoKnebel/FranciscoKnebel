---
import { getCollection } from 'astro:content';
import type { Lang } from '../types';
import ui from '../data/ui.json';
import { slugFromId } from '../lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

const entries = (await getCollection('projects', ({ data }) => data.lang === lang)).sort(
  (a, b) => a.data.order - b.data.order,
);
const projects = entries.map((entry) => ({
  slug: slugFromId(entry.id),
  ...entry.data,
}));
const projectHref = (slug: string) => `${lang === 'pt' ? '/pt' : ''}/projects/${slug}/`;
const caseStudiesUrl = lang === 'pt' ? '/pt/case-studies/' : '/case-studies/';
---

<section
  id="projects"
  class="border-t border-slate-100 py-24 dark:border-slate-800/60"
  aria-labelledby="projects-heading"
>
  <div class="mx-auto max-w-6xl px-6">
    <h2 id="projects-heading" class="section-heading reveal">{t.sections.projects}</h2>

    <div class="reveal-stagger mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((project) => (
          <article class="card-hover flex flex-col rounded-xl border border-slate-200 bg-slate-50 p-5 dark:border-slate-800 dark:bg-slate-900/50">
            <h3 class="mb-2 text-sm font-semibold text-slate-900 dark:text-slate-100">
              <a
                href={projectHref(project.slug)}
                class="hover:text-accent-600 focus-visible:ring-accent-500 dark:hover:text-accent-400 rounded underline-offset-2 transition-colors duration-150 hover:underline focus-visible:ring-2 focus-visible:outline-none"
              >
                {project.title}
              </a>
            </h3>
            <p class="flex-1 text-sm leading-relaxed text-slate-500 dark:text-slate-400">
              {project.description}
            </p>

            <div class="mt-4 flex flex-wrap gap-2">
              {project.repo && (
                <a
                  href={project.repo}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${t.projectsPage.repo}: ${project.title}`}
                  class="focus-visible:ring-accent-500 inline-flex min-h-11 items-center rounded-lg border border-slate-300 px-3 text-sm font-medium text-slate-700 underline-offset-2 hover:underline focus-visible:ring-2 focus-visible:outline-none dark:border-slate-600 dark:text-slate-200"
                >
                  {t.projectsPage.repo}
                </a>
              )}
              {project.url && (
                <a
                  href={project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${t.projectsPage.live}: ${project.title}`}
                  class="focus-visible:ring-accent-500 inline-flex min-h-11 items-center rounded-lg border border-slate-300 px-3 text-sm font-medium text-slate-700 underline-offset-2 hover:underline focus-visible:ring-2 focus-visible:outline-none dark:border-slate-600 dark:text-slate-200"
                >
                  {t.projectsPage.live}
                </a>
              )}
            </div>

            {project.tags.length > 0 && (
              <div class="mt-4 flex flex-wrap gap-1.5 border-t border-slate-200 pt-4 dark:border-slate-800">
                {project.tags.map((tag) => (
                  <span class="inline-flex items-center rounded-md bg-slate-200 px-2 py-0.5 text-xs text-slate-600 dark:bg-slate-800 dark:text-slate-300">
                    {tag}
                  </span>
                ))}
              </div>
            )}
          </article>
        ))
      }
    </div>

    <p class="reveal mt-6 text-xs text-slate-500 dark:text-slate-400">
      {t.sections.moreProjects}{' '}
      <a
        href="https://github.com/FranciscoKnebel"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-accent-500 underline underline-offset-2 transition-colors duration-150"
        >GitHub</a
      >.
    </p>

    <a
      href={caseStudiesUrl}
      class="reveal text-accent-600 hover:text-accent-500 dark:text-accent-400 dark:hover:text-accent-300 mt-4 inline-flex items-center gap-1.5 text-sm font-medium transition-colors duration-150"
    >
      {t.sections.caseStudies}
      <span aria-hidden="true">→</span>
    </a>
  </div>
</section>
