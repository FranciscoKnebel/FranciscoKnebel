---
import type { Lang } from '../types';
import ui from '../data/ui.json';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
---

<section id="stats" class="border-t border-slate-100 py-24 dark:border-slate-800/60">
  <div class="mx-auto max-w-6xl px-6">
    <p class="section-heading reveal">{t.sections.stats}</p>

    <div class="reveal-stagger mt-8 grid grid-cols-1 gap-4 md:grid-cols-5">
      <div class="col-span-5 overflow-hidden rounded-xl bg-slate-50 md:col-span-2">
        <img
          src="/github-metrics.svg"
          alt="GitHub metrics overview"
          width="480"
          height="367"
          class="block h-auto w-full"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div
        class="col-span-5 overflow-hidden rounded-xl bg-slate-50 md:col-span-3 dark:bg-slate-900/50"
      >
        <picture>
          <source
            media="(prefers-color-scheme: dark)"
            srcset="/profile-3d-contrib/profile-night-view.svg"
          />
          <img
            src="/profile-3d-contrib/profile-gitblock.svg"
            alt="3D GitHub contribution calendar"
            width="1280"
            height="850"
            class="block h-auto w-full"
            loading="lazy"
            decoding="async"
          />
        </picture>
      </div>
      <div class="col-span-3 col-start-2 overflow-hidden rounded-xl bg-slate-50">
        <img
          src="/metrics.plugin.calendar.svg"
          alt="GitHub contribution calendar"
          width="480"
          height="129"
          class="block h-auto w-full"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>
