---
import type { Lang } from '../types';
import Nav from './Nav.astro';
import Footer from './Footer.astro';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  backHref: string;
  backLabel: string;
}
const { lang, title, description, backHref, backLabel } = Astro.props;
---

<Nav lang={lang} />
<main id="main" tabindex="-1" class="pt-14">
  <article class="border-t border-slate-100 py-20 dark:border-slate-800/60">
    <div class="mx-auto max-w-3xl px-6">
      <a
        href={backHref}
        class="text-accent-600 hover:text-accent-500 dark:text-accent-400 inline-flex items-center gap-1.5 text-sm font-medium transition-colors duration-150"
      >
        <span aria-hidden="true">←</span>
        {backLabel}
      </a>

      <slot name="badge" />

      <h1
        class="mt-6 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-slate-50"
      >
        {title}
      </h1>
      <p class="mt-3 text-base leading-relaxed text-slate-500 dark:text-slate-400">
        {description}
      </p>

      <slot name="meta" />

      <div class="prose prose-slate dark:prose-invert mt-10 max-w-none">
        <slot />
      </div>
    </div>
  </article>
</main>
<Footer lang={lang} />
