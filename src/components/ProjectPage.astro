---
import { render, type CollectionEntry } from 'astro:content';
import type { Lang } from '../types';
import ui from '../data/ui.json';
import Nav from './Nav.astro';
import Footer from './Footer.astro';

interface Props {
  entry: CollectionEntry<'projects'>;
  lang: Lang;
}
const { entry, lang } = Astro.props;
const t = ui[lang];
const { Content } = await render(entry);

const projectsUrl = lang === 'pt' ? '/pt/#projects' : '/#projects';
const linkClass =
  'inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm font-medium text-slate-600 transition-colors duration-150 hover:border-slate-300 hover:text-accent-600 focus-visible:ring-2 focus-visible:ring-accent-500 focus-visible:outline-none dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:border-slate-600 dark:hover:text-accent-400';
---

<Nav lang={lang} />
<main class="pt-14">
  <article class="border-t border-slate-100 py-20 dark:border-slate-800/60">
    <div class="mx-auto max-w-3xl px-6">
      <a
        href={projectsUrl}
        class="text-accent-600 hover:text-accent-500 dark:text-accent-400 inline-flex items-center gap-1.5 text-sm font-medium transition-colors duration-150"
      >
        <span aria-hidden="true">←</span>
        {t.projectsPage.back}
      </a>

      <h1
        class="mt-6 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-slate-50"
      >
        {entry.data.title}
      </h1>
      <p class="mt-3 text-base leading-relaxed text-slate-500 dark:text-slate-400">
        {entry.data.description}
      </p>

      <div class="mt-5 flex flex-wrap gap-3">
        {
          entry.data.repo && (
            <a href={entry.data.repo} target="_blank" rel="noopener noreferrer" class={linkClass}>
              {t.projectsPage.repo}
            </a>
          )
        }
        {
          entry.data.url && (
            <a href={entry.data.url} target="_blank" rel="noopener noreferrer" class={linkClass}>
              {t.projectsPage.live}
            </a>
          )
        }
      </div>

      <div class="mt-4 flex flex-wrap gap-1.5">
        {
          entry.data.tags.map((tag) => (
            <span class="inline-flex items-center rounded-md bg-slate-200 px-2 py-0.5 text-xs text-slate-600 dark:bg-slate-800 dark:text-slate-300">
              {tag}
            </span>
          ))
        }
      </div>

      <div class="prose prose-slate dark:prose-invert mt-10 max-w-none">
        <Content />
      </div>
    </div>
  </article>
</main>
<Footer lang={lang} />
