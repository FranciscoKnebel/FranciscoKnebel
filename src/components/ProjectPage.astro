---
import { render, type CollectionEntry } from 'astro:content';
import type { Lang } from '../types';
import ui from '../data/ui.json';
import ContentPage from './ContentPage.astro';

interface Props {
  entry: CollectionEntry<'projects'>;
  lang: Lang;
}
const { entry, lang } = Astro.props;
const t = ui[lang];
const { Content } = await render(entry);

const backHref = lang === 'pt' ? '/pt/#projects' : '/#projects';
const linkClass =
  'inline-flex items-center gap-2 rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-sm font-medium text-slate-600 transition-colors duration-150 hover:border-slate-300 hover:text-accent-600 focus-visible:ring-2 focus-visible:ring-accent-500 focus-visible:outline-none dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300 dark:hover:border-slate-600 dark:hover:text-accent-400';
---

<ContentPage
  lang={lang}
  title={entry.data.title}
  description={entry.data.description}
  backHref={backHref}
  backLabel={t.projectsPage.back}
>
  <div slot="meta" class="mt-5 flex flex-col gap-4">
    {
      (entry.data.repo || entry.data.url) && (
        <div class="flex flex-wrap gap-3">
          {entry.data.repo && (
            <a href={entry.data.repo} target="_blank" rel="noopener noreferrer" class={linkClass}>
              {t.projectsPage.repo}
            </a>
          )}
          {entry.data.url && (
            <a href={entry.data.url} target="_blank" rel="noopener noreferrer" class={linkClass}>
              {t.projectsPage.live}
            </a>
          )}
        </div>
      )
    }
    <div class="flex flex-wrap gap-1.5">
      {
        entry.data.tags.map((tag) => (
          <span class="inline-flex items-center rounded-md bg-slate-200 px-2 py-0.5 text-xs text-slate-600 dark:bg-slate-800 dark:text-slate-300">
            {tag}
          </span>
        ))
      }
    </div>
  </div>

  <Content />
</ContentPage>
