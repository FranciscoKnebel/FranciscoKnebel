---
import type { Lang, Experience } from '../types';
import ui from '../data/ui.json';
import experiencesData from '../data/experiences.json';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const groups = new Map<string, Experience[]>();
for (const experience of experiencesData) {
  groups.set(experience.company, [...(groups.get(experience.company) ?? []), experience]);
}
---

<section
  id="experience"
  class="border-t border-slate-100 py-24 dark:border-slate-800/60"
  aria-labelledby="experience-heading"
>
  <div class="mx-auto max-w-6xl px-6">
    <h2 id="experience-heading" class="section-heading reveal">{t.sections.experience}</h2>
    <div class="reveal-stagger mt-8 space-y-10">
      {
        Array.from(groups, ([company, roles]) => (
          <article class="border-l-2 border-slate-200 pl-5 dark:border-slate-700">
            <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100">
              {roles[0].companyUrl ? (
                <a
                  class="bio-link"
                  href={roles[0].companyUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {company}
                </a>
              ) : (
                company
              )}
            </h3>
            {roles.length > 1 && roles.every((role) => role.current) && (
              <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
                {t.experience.concurrent}
              </p>
            )}
            <div class="mt-5 space-y-7">
              {roles.map((exp) => (
                <div>
                  <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
                    <h4 class="text-base font-semibold text-slate-900 dark:text-slate-100">
                      {exp.role[lang]}
                    </h4>
                    <span class="font-mono text-xs text-slate-600 dark:text-slate-300">
                      {exp.period[lang]}
                    </span>
                  </div>
                  <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
                    {exp.location[lang]}
                  </p>
                  <p
                    class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300"
                    set:html={exp.description[lang]}
                  />
                  {exp.tags.length > 0 && (
                    <div class="mt-3 flex flex-wrap gap-1.5">
                      {exp.tags.map((tag) => (
                        <span class="inline-flex items-center rounded-md bg-slate-200 px-2 py-0.5 text-xs font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-300">
                          {tag}
                        </span>
                      ))}
                    </div>
                  )}
                </div>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
