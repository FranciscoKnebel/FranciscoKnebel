---
import { getCollection } from 'astro:content';
import type { Lang } from '../types';
import ui from '../data/ui.json';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import { slugFromId } from '../lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

const entries = (await getCollection('caseStudies', ({ data }) => data.lang === lang)).sort(
  (a, b) => a.data.order - b.data.order,
);
const caseStudyHref = (slug: string) => `${lang === 'pt' ? '/pt' : ''}/case-studies/${slug}/`;
---

<Nav lang={lang} />
<main class="pt-14">
  <section class="border-t border-slate-100 py-20 dark:border-slate-800/60">
    <div class="mx-auto max-w-4xl px-6">
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-slate-50">
        {t.caseStudiesPage.title}
      </h1>
      <p class="mt-3 max-w-2xl text-base leading-relaxed text-slate-500 dark:text-slate-400">
        {t.caseStudiesPage.description}
      </p>

      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        {
          entries.map((entry) => {
            const slug = slugFromId(entry.id);
            return (
              <a
                href={caseStudyHref(slug)}
                class="card-hover group focus-visible:ring-accent-500 flex flex-col rounded-xl border border-slate-200 bg-slate-50 p-5 transition-colors duration-150 focus-visible:ring-2 focus-visible:outline-none dark:border-slate-800 dark:bg-slate-900/50"
              >
                {entry.data.status === 'planned' && (
                  <span class="mb-3 inline-flex w-fit items-center rounded-md bg-slate-200 px-2 py-0.5 text-xs font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-300">
                    {t.caseStudiesPage.comingSoon}
                  </span>
                )}
                <h2 class="group-hover:text-accent-600 dark:group-hover:text-accent-400 text-base font-semibold text-slate-900 transition-colors duration-150 dark:text-slate-100">
                  {entry.data.title}
                </h2>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-500 dark:text-slate-400">
                  {entry.data.description}
                </p>
                <div class="mt-4 flex flex-wrap gap-1.5 border-t border-slate-200 pt-4 dark:border-slate-800">
                  {entry.data.topics.map((topic) => (
                    <span class="inline-flex items-center rounded-md bg-slate-200 px-2 py-0.5 text-xs text-slate-600 dark:bg-slate-800 dark:text-slate-300">
                      {topic}
                    </span>
                  ))}
                </div>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>
</main>
<Footer lang={lang} />
