---
import type { Lang, Publication } from '../types';
import ui from '../data/ui.json';
import { publicationTypeColors } from '../lib/publications';

interface Props {
  publication: Publication;
  lang: Lang;
  bibtex?: string;
}
const { publication, lang, bibtex } = Astro.props;
const t = ui[lang];

const normalize = (value: string) =>
  value
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase();
const search = normalize(
  `${publication.title} ${publication.authors.join(' ')} ${publication.venue}`,
);
---

<article
  data-publication
  data-search={search}
  data-type={publication.type}
  data-year={String(publication.year)}
  class="card-hover group rounded-xl border border-slate-200 bg-slate-50 p-5 dark:border-slate-800 dark:bg-slate-900/50"
>
  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0 flex-1">
      <div class="mb-2 flex flex-wrap items-center gap-2">
        <span
          class={`inline-flex items-center rounded-md px-2 py-0.5 text-xs font-semibold ${
            publicationTypeColors[publication.type] ?? 'bg-slate-100 text-slate-600'
          }`}
        >
          {
            t.publications.types[publication.type as keyof typeof t.publications.types] ??
              publication.type
          }
        </span>
        <span
          class="inline-flex items-center rounded-md bg-slate-300 px-2 py-0.5 text-xs text-slate-600 dark:bg-slate-800 dark:text-slate-400"
        >
          {publication.year}
        </span>
        {
          publication.citations ? (
            <span class="inline-flex items-center rounded-md bg-slate-200 px-2 py-0.5 text-xs text-slate-600 dark:bg-slate-800 dark:text-slate-400">
              {publication.citations} {t.publications.citations}
            </span>
          ) : null
        }
      </div>

      {
        publication.url ? (
          <a
            href={publication.url}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-accent-600 dark:hover:text-accent-400 text-sm leading-snug font-medium text-slate-900 underline-offset-2 transition-colors duration-150 hover:underline dark:text-slate-100"
          >
            {publication.title}
          </a>
        ) : (
          <p class="text-sm leading-snug font-medium text-slate-900 dark:text-slate-100">
            {publication.title}
          </p>
        )
      }

      <p class="mt-1.5 text-xs text-slate-500 dark:text-slate-400">
        {publication.authors.join(', ')}
      </p>

      <p class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">
        {
          publication.venueUrl ? (
            <a
              href={publication.venueUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-accent-500 hover:decoration-accent-400 dark:hover:text-accent-400 underline decoration-slate-300 underline-offset-2 transition-colors duration-150 dark:decoration-slate-600"
            >
              {publication.venue}
            </a>
          ) : (
            publication.venue
          )
        }
        {
          publication.advisor && (
            <span class="text-slate-500 dark:text-slate-400">
              {' '}
              · {t.publications.advisor}:{' '}
              {publication.advisorUrl ? (
                <a
                  href={publication.advisorUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-accent-400 hover:decoration-accent-400 dark:hover:text-accent-400 underline decoration-slate-300 underline-offset-2 transition-colors duration-150 dark:decoration-slate-600"
                >
                  {publication.advisor}
                </a>
              ) : (
                publication.advisor
              )}
            </span>
          )
        }
      </p>

      {
        bibtex && (
          <details class="mt-3">
            <summary class="hover:text-accent-600 dark:hover:text-accent-400 w-fit cursor-pointer text-xs font-medium text-slate-500 transition-colors duration-150 dark:text-slate-400">
              {t.publicationsPage.bibtex}
            </summary>
            <pre class="mt-2 overflow-x-auto rounded-lg bg-slate-100 p-3 text-xs leading-relaxed text-slate-700 dark:bg-slate-950/60 dark:text-slate-300">
              {bibtex}
            </pre>
          </details>
        )
      }
    </div>

    {
      publication.url && (
        <a
          href={publication.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${t.publicationsPage.open} ${publication.title}`}
          class="group-hover:text-accent-500 focus-visible:ring-accent-500 dark:group-hover:text-accent-400 mt-1 flex-shrink-0 rounded text-slate-300 transition-colors duration-150 focus-visible:ring-2 focus-visible:outline-none dark:text-slate-600"
        >
          <svg
            class="h-4 w-4"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
            />
          </svg>
        </a>
      )
    }
  </div>
</article>
