---
import type { Lang } from '../types';
import ui from '../data/ui.json';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

const pathname = Astro.url.pathname;
const otherLang: Lang = lang === 'en' ? 'pt' : 'en';
const otherPath =
  lang === 'en'
    ? pathname === '/'
      ? '/pt/'
      : `/pt${pathname}`
    : pathname.replace(/^\/pt(?=\/|$)/, '') || '/';
---

<div id="language-notice" class="fixed inset-x-0 top-14 z-40 hidden px-4 pt-3">
  <div
    class="mx-auto flex max-w-2xl items-center gap-3 rounded-xl border border-slate-200 bg-white/95 p-3 shadow-lg backdrop-blur-md dark:border-slate-800 dark:bg-slate-900/95"
  >
    <p class="flex-1 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
      {t.languageNotice.message}
    </p>
    <a
      id="language-notice-link"
      href={otherPath}
      hreflang={otherLang}
      class="btn bg-accent-600 hover:bg-accent-500 focus-visible:ring-accent-500 flex-shrink-0 rounded-lg px-3 py-2 text-sm font-medium text-white transition-colors duration-150 focus-visible:ring-2 focus-visible:outline-none"
    >
      {t.languageNotice.action}
    </a>
    <button
      id="language-notice-dismiss"
      type="button"
      aria-label={t.languageNotice.dismiss}
      class="focus-visible:ring-accent-500 flex-shrink-0 rounded-md p-1.5 text-slate-400 transition-colors duration-150 hover:bg-slate-100 hover:text-slate-600 focus-visible:ring-2 focus-visible:outline-none dark:text-slate-500 dark:hover:bg-slate-800 dark:hover:text-slate-300"
    >
      <svg
        class="h-4 w-4"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>
</div>

<script>
  const STORAGE_KEY = 'language-choice';
  const notice = document.getElementById('language-notice');
  const dismiss = document.getElementById('language-notice-dismiss');
  const current = document.documentElement.lang === 'pt' ? 'pt' : 'en';
  const browser = (navigator.language || '').toLowerCase();
  const prefers = browser.startsWith('pt') ? 'pt' : browser.startsWith('en') ? 'en' : null;
  const stored = localStorage.getItem(STORAGE_KEY);

  if (!stored && prefers && prefers !== current) {
    notice?.classList.remove('hidden');
  }

  dismiss?.addEventListener('click', () => {
    localStorage.setItem(STORAGE_KEY, current);
    notice?.classList.add('hidden');
  });

  // Remember explicit language choices made through any language link
  document.querySelectorAll('a[hreflang]').forEach((link) => {
    link.addEventListener('click', () => {
      const chosen = link.getAttribute('hreflang');
      if (chosen) localStorage.setItem(STORAGE_KEY, chosen);
    });
  });
</script>
