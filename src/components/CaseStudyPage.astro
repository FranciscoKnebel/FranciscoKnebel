---
import { render, type CollectionEntry } from 'astro:content';
import type { Lang } from '../types';
import ui from '../data/ui.json';
import ContentPage from './ContentPage.astro';

interface Props {
  entry: CollectionEntry<'caseStudies'>;
  lang: Lang;
}
const { entry, lang } = Astro.props;
const t = ui[lang];
const { Content } = await render(entry);

const backHref = lang === 'pt' ? '/pt/case-studies/' : '/case-studies/';
---

<ContentPage
  lang={lang}
  title={entry.data.title}
  description={entry.data.description}
  backHref={backHref}
  backLabel={t.caseStudiesPage.back}
>
  {
    entry.data.status === 'planned' && (
      <p
        slot="badge"
        class="mt-6 inline-flex items-center rounded-md bg-slate-200 px-2 py-0.5 text-xs font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-300"
      >
        {t.caseStudiesPage.comingSoon}
      </p>
    )
  }

  <div slot="meta" class="mt-4 flex flex-wrap gap-1.5">
    {
      entry.data.topics.map((topic) => (
        <span class="inline-flex items-center rounded-md bg-slate-200 px-2 py-0.5 text-xs text-slate-600 dark:bg-slate-800 dark:text-slate-300">
          {topic}
        </span>
      ))
    }
  </div>

  <Content />
</ContentPage>
